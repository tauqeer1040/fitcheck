<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for the 2x5 (API 31+ launchers inflate this
     instead of previewImage). Without it the picker draws a bare box
     labelled "2 x 5". Mirrors widget_recent_stickers_layout exactly —
     same 8dp padding, three weighted cells with a 2dp gap, caption
     below — so the card in the picker reads as the widget itself. The
     silhouettes and cutouts are the baked previews (the launcher
     inflates this with none of our data, so it can't be live). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_preview_cell_0" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_preview_cell_1" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_preview_cell_2" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:text="@string/widget_preview_caption"
        android:textColor="#CCFFFFFF"
        android:textSize="17sp"
        android:textStyle="italic" />

</LinearLayout>