<?xml version="1.0" encoding="utf-8"?>
<!-- 2x5 widget: transparent — three recent cutouts, each floating over
     its own tinted silhouette, with the latest sticker's roast as a
     caption underneath (funny lines included, lockscreen included). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp">

            <!-- 15 rotation frames stamped at update time (24deg steps,
                 1 frame/sec = 15s turn). Static XML would triple the view
                 count; addView keeps it lean. -->
            <ViewFlipper
                android:id="@+id/widget_spin_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="1000" />

            <ImageView
                android:id="@+id/widget_sticker_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Recent sticker 1" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp">

            <ViewFlipper
                android:id="@+id/widget_spin_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="1000" />

            <ImageView
                android:id="@+id/widget_sticker_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Recent sticker 2" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ViewFlipper
                android:id="@+id/widget_spin_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="1000" />

            <ImageView
                android:id="@+id/widget_sticker_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Recent sticker 3" />

        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/widget_funny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textSize="17sp"
        android:textStyle="italic"
        android:textColor="#CCFFFFFF"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:maxLines="2"
        android:ellipsize="end"
        android:contentDescription="@null" />

</LinearLayout>
