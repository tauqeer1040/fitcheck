<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 widget: 12-cookie M3E container, latest sticker floating over
     it with negative margins so it leaks past the edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_sticker_latest"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="-14dp"
        android:scaleType="fitCenter"
        android:contentDescription="Latest sticker" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No stickers yet"
        android:textSize="12sp"
        android:textColor="#98989E"
        android:visibility="visible" />

</FrameLayout>
