<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ granular media permissions: declaring these is what lets
         the OS show the runtime permission popup instead of denying silently. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Pre-Android 13 fallback -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
        <!-- Single-image picking via photo picker (no runtime permission needed) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PICK"/>
            <data android:mimeType="image/*"/>
        </intent>
    </queries>
    <!-- Visibility for the WhatsApp sticker-pack add intent (official
         third-party sticker API). Without this, Android 11+ package
         filtering hides both WhatsApp flavors from the chooser. -->
    <queries>
        <intent>
            <action android:name="com.whatsapp.intent.action.ENABLE_STICKER_PACK"/>
        </intent>
    </queries>
    <application
        android:label="StickerPants"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Official WhatsApp third-party sticker API: serves the user's
             generated pack (filesDir/sticker_packs/) when WhatsApp fetches
             metadata and sticker assets during pack add. Exported with the
             WhatsApp read permission exactly as the sample apps declare. -->
        <provider
            android:name=".StickerContentProvider"
            android:authorities="com.taucity.stickerpants.stickercontentprovider"
            android:exported="true"
            android:enabled="true"
            android:readPermission="com.whatsapp.sticker.READ" />

        <!-- Homescreen widgets: 2x4 (three recent stickers) and 2x2
             (latest sticker). home_widget's provider base class handles
             the SharedPreferences bridge from Dart. -->
        <receiver
            android:name=".RecentStickersWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_stickers_widget_info" />
        </receiver>
        <receiver
            android:name=".LatestStickerWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/latest_sticker_widget_info" />
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
