default_platform(:android)

# Resolve the repo root from this file rather than the current directory, so
# every path works whether fastlane is invoked from android/ or the root.
REPO_ROOT = File.expand_path("../..", __dir__)
AAB_PATH = File.join(REPO_ROOT, "build/app/outputs/bundle/release/app-release.aab")
METADATA_PATH = File.join(REPO_ROOT, "android/fastlane/metadata/android")
JSON_KEY = File.join(REPO_ROOT, "android/fbm/stickerpants-play.json")

# Release build flags for the Play upload.
#   --obfuscate          shortens Dart identifiers in libapp.so
#   --split-debug-info   strips DWARF out of the shipped .so files
# Both shrink what Play serves, and neither costs you symbolication: AGP
# packages the symbol data into the .aab itself, so nothing needs uploading
# separately (see the note below).
SYMBOLS_PATH = File.join(REPO_ROOT, "build/app/outputs/symbols")
RELEASE_BUILD = "flutter build appbundle --release --obfuscate " \
                "--split-debug-info=#{SYMBOLS_PATH}"

# No separate deobfuscation upload is needed. AGP packages both symbol kinds
# into the .aab and Play ingests them on upload:
#   BUNDLE-METADATA/com.android.tools.build.obfuscation/proguard.map    (R8/Java)
#   BUNDLE-METADATA/com.android.tools.build.debugsymbols/<abi>/*.so.sym (native ELF)
# Keep the build/app/outputs/symbols copy anyway as a local backup.
#
# (Verified for this app: all seven shipped arm64 .so files carry zero debug
# sections, so the DWARF --split-debug-info strips is not what users download.)

platform :android do
  desc "Upload store listing metadata (text + graphics) to the Play Console internal draft"
  lane :metadata do
    supply(
      track: "internal",
      release_status: "draft",
      # Internal holds multiple releases (vc2 + vc3 draft); supply requires a
      # :version_code to disambiguate, and it must name a release that actually
      # exists on the track or the upload aborts. vc3 is the newest draft.
      # This is NOT pubspec's buildNumber (9) — that release is not on internal.
      version_code: 3,
      metadata_path: METADATA_PATH,
      json_key: JSON_KEY,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      check_superseded_tracks: true
    )
  end

  desc "Upload the prebuilt release AAB + metadata + graphics to the Play Console internal draft"
  lane :deploy do
    supply(
      track: "internal",
      release_status: "draft",
      metadata_path: METADATA_PATH,
      json_key: JSON_KEY,
      aab: AAB_PATH,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      check_superseded_tracks: true
    )
  end

  desc "Build the release AAB and ship it to the Play production track (full rollout)"
  lane :prod do
    # Version comes from pubspec.yaml (versionName+buildNumber); bump the
    # build number before running — Play rejects a reused versionCode.
    # Symbols need NO separate upload: AGP bundles both into the .aab and Play
    # ingests them on upload --
    #   BUNDLE-METADATA/com.android.tools.build.obfuscation/proguard.map   (R8/Java)
    #   BUNDLE-METADATA/com.android.tools.build.debugsymbols/<abi>/*.so.sym (native ELF)
    # So crash traces stay readable while the shipped .so files stay stripped
    # (--split-debug-info removes DWARF from what users actually download).
    sh("cd #{REPO_ROOT} && #{RELEASE_BUILD}")
    supply(
      aab: AAB_PATH,
      track: "production",
      release_status: "completed",
      json_key: JSON_KEY,
      # The live listing is managed via the `metadata` lane; uploading the
      # local metadata folder here would overwrite it.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      check_superseded_tracks: true
    )
  end

  desc "Build the release AAB and ship it to the Play production track as a staged rollout (default 20%)"
  lane :prod_staged do |options|
    user_fraction = (options[:fraction] || 0.2).to_f
    sh("cd #{REPO_ROOT} && #{RELEASE_BUILD}")
    supply(
      aab: AAB_PATH,
      track: "production",
      release_status: "inProgress",
      rollout: user_fraction,
      json_key: JSON_KEY,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      check_superseded_tracks: true
    )
  end
end
